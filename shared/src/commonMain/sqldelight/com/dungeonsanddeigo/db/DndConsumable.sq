CREATE TABLE DndConsumable (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    characterId INTEGER NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    effect TEXT NOT NULL DEFAULT '',
    price INTEGER NOT NULL DEFAULT 0,
    priceCurrency TEXT NOT NULL DEFAULT 'pg',
    weight REAL NOT NULL DEFAULT 0.0,
    tags TEXT NOT NULL DEFAULT '',
    FOREIGN KEY (characterId) REFERENCES CharacterEntity(id)
);

selectByCharacterId:
SELECT * FROM DndConsumable WHERE characterId = ?;

insert:
INSERT INTO DndConsumable(characterId, name, type, quantity, effect, price, priceCurrency, weight, tags)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

update:
UPDATE DndConsumable SET name = ?, type = ?, quantity = ?, effect = ?, price = ?, priceCurrency = ?, weight = ?, tags = ?
WHERE id = ?;

deleteById:
DELETE FROM DndConsumable WHERE id = ?;
