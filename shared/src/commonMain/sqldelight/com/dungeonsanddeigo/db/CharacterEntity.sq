CREATE TABLE CharacterEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    sheetModelName TEXT NOT NULL,
    imageBase64 TEXT
);

selectAll:
SELECT * FROM CharacterEntity;

selectById:
SELECT * FROM CharacterEntity WHERE id = ?;

insert:
INSERT INTO CharacterEntity(name, sheetModelName, imageBase64) VALUES (?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();
